{
  "name": "playwright-typescript-sample",
  "version": "1.0.0",
  "description": "A personal sample project showing how I structure Playwright TypeScript tests.",
  "private": true,
  "license": "MIT",
  "author": "Richard Li",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:chrome": "playwright test --project=chrome",
    "test:edge": "playwright test --project=edge",
    "test:api": "playwright test --project=api",
    "test:stability": "playwright test --repeat-each=10",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "triage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/triage-failures.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
